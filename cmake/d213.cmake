# Pass -DRTAA_D213_TOOLCHAIN=<Luban-Lite>/toolchain on Windows.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES RTAA_D213_TOOLCHAIN)
if(NOT RTAA_D213_TOOLCHAIN)
  message(FATAL_ERROR "Set RTAA_D213_TOOLCHAIN to the existing D213 toolchain directory")
endif()
set(CMAKE_C_COMPILER "${RTAA_D213_TOOLCHAIN}/bin/riscv64-unknown-elf-gcc.exe")
set(CMAKE_CXX_COMPILER "${RTAA_D213_TOOLCHAIN}/bin/riscv64-unknown-elf-g++.exe")
set(CMAKE_AR "${RTAA_D213_TOOLCHAIN}/bin/riscv64-unknown-elf-ar.exe")
set(CMAKE_RANLIB "${RTAA_D213_TOOLCHAIN}/bin/riscv64-unknown-elf-ranlib.exe")
set(CMAKE_C_FLAGS_INIT "-march=rv64imafdc_xtheadc -mabi=lp64d -mcmodel=medany -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
